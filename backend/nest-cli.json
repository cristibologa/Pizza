{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": ["@nestjs/graphql"],
    "assets": [
      { "include": "static/**/*", "watchAssets": true },
      { "include": "views/**/*", "watchAssets": true }
    ]
  }
}
